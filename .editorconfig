# .editorconfig — fixe l'encodage, les fins de ligne et l'indentation du dépôt.
#
# Lu par les éditeurs et par les outils qui respectent le format : c'est ici
# qu'on aligne les conventions d'un langage à l'autre (4 espaces en C# et en
# shell, 2 ailleurs).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj}]
indent_size = 4

[*.{sh,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
