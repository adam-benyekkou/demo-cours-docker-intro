# Interface de la stack. Copier en `.env` et renseigner les valeurs.
# Ce fichier est le contrat unique entre l'application, Terraform et la CI.
APP_IMAGE=ghcr.io/adam-benyekkou/demo-cours-docker-intro/app
APP_IMAGE_TAG=local
DOMAIN=app.localhost
# Recopié dans stack/secrets/grafana_admin_password par stack/local-tls.sh,
# puis monté dans Grafana : la valeur ne passe jamais par l'environnement.
GRAFANA_ADMIN_PASSWORD=change-me
