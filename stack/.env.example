# Interface de la stack. Copier en `.env` et renseigner les valeurs.
# Ce fichier est le contrat unique entre l'application, Terraform et la CI.
DOMAIN=app.localhost
# Mot de passe Grafana, passé en variable d'environnement du conteneur.
GRAFANA_ADMIN_PASSWORD=change-me
# Version affichée par l'application ; la CI y met le SHA du commit.
APP_VERSION=local
