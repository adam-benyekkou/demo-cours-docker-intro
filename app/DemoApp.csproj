<!-- DemoApp.csproj — décrit l'application web .NET 10 et ses dépendances. -->
<!-- -->
<!-- Cible net10.0, nullabilité et usings implicites, culture invariante. -->
<!-- Un seul paquet : prometheus-net.AspNetCore ; ajouter ici une dépendance. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DemoApp</RootNamespace>
    <AssemblyName>DemoApp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

</Project>
