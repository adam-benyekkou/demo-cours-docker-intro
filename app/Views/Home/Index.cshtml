@model AppInfo
@{
    ViewData["Title"] = "Accueil";
}

<h1>Bonjour depuis le conteneur</h1>
<p class="lead">
    Cette page est servie par une application MVC factice, derrière Traefik,
    surveillée par Prometheus et Grafana. Le titre de cette page est le témoin
    utilisé par le test de fumée du déploiement.
</p>

<section class="grid">
    <article class="card">
        <h2>Hôte</h2>
        <dl>
            <dt>Nom du conteneur</dt><dd>@Model.Host</dd>
            <dt>Environnement</dt><dd>@Model.Environment</dd>
            <dt>Version</dt><dd>@Model.Version</dd>
            <dt>Runtime .NET</dt><dd>@Model.Runtime</dd>
        </dl>
    </article>

    <article class="card">
        <h2>Cycle de vie</h2>
        <dl>
            <dt>Démarré à</dt><dd>@Model.StartedAt.ToString("u")</dd>
            <dt>Disponibilité</dt><dd>@Model.Uptime</dd>
            <dt>Adresse client vue par l'appli</dt><dd>@ViewData["ClientAddress"]</dd>
            <dt>X-Forwarded-For</dt><dd>@ViewData["ForwardedFor"]</dd>
        </dl>
    </article>

    <article class="card">
        <h2>Observabilité</h2>
        <p>
            Métriques Prometheus et cibles de collecte internes au réseau Docker :
            elles ne sont pas publiées sur Internet.
        </p>
        <p>
            Dashboards : <a href="/grafana/">Grafana</a>.
        </p>
    </article>
</section>
