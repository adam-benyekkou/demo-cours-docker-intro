@{
    ViewData["Title"] = "Accueil";
}

<h1>Bonjour depuis le conteneur</h1>
<p class="lead">
    Cette page est servie par une application MVC factice, derrière Traefik,
    surveillée par Prometheus et Grafana. Le titre de cette page est le témoin
    utilisé par le test de fumée du déploiement.
</p>

<section class="grid">
    <article class="card">
        <h2>Hôte</h2>
        <dl>
            <dt>Nom du conteneur</dt><dd>@ViewData["Host"]</dd>
            <dt>Environnement</dt><dd>@ViewData["Environment"]</dd>
            <dt>Version</dt><dd>@ViewData["Version"]</dd>
            <dt>Runtime .NET</dt><dd>@ViewData["Runtime"]</dd>
        </dl>
    </article>

    <article class="card">
        <h2>Cycle de vie</h2>
        <dl>
            <dt>Démarré à</dt><dd>@ViewData["StartedAt"]</dd>
            <dt>Disponibilité</dt><dd>@ViewData["Uptime"]</dd>
            <dt>Adresse vue par l'appli</dt><dd>@ViewData["Requests"]</dd>
            <dt>X-Forwarded-For</dt><dd>@ViewData["ForwardedFor"]</dd>
        </dl>
    </article>

    <article class="card">
        <h2>Observabilité</h2>
        <p>
            <a href="/metrics">Métriques Prometheus</a> de l'application,
            scrapées par le service <code>prometheus</code>.
        </p>
        <p>
            Dashboards : <a href="/grafana/">Grafana</a>. Les cibles
            Prometheus ne sont pas exposées sur Internet.
        </p>
    </article>
</section>
