@* Views/Home/Error.cshtml — page affichée après une exception non gérée. *@
@* *@
@* Câblée par UseExceptionHandler("/Home/Error") dans Program.cs. *@
@* Elle affiche l'identifiant de requête et un lien de retour à l'accueil. *@
@{
    ViewData["Title"] = "Erreur";
}

<h1>Une erreur est survenue</h1>
<p>Identifiant de la requête : <code>@ViewData["RequestId"]</code></p>
<p><a href="/">Retour à l'accueil</a></p>
