# Partial configuration on purpose: the storage account name is generated by
# infra/bootstrap/bootstrap.sh, so CI supplies the remaining settings at init time:
#
#   terraform init \
#     -backend-config="resource_group_name=${TF_STATE_RESOURCE_GROUP}" \
#     -backend-config="storage_account_name=${TF_STATE_STORAGE_ACCOUNT}" \
#     -backend-config="container_name=tfstate" \
#     -backend-config="key=demo-cours-docker-intro.tfstate" \
#     -backend-config="use_oidc=true" \
#     -backend-config="use_azuread_auth=true"
terraform {
  backend "azurerm" {
    container_name = "tfstate"
    key            = "demo-cours-docker-intro.tfstate"
  }
}
