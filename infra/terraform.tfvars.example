# Copy to terraform.tfvars and adjust. The comments say which values differ from
# the module defaults in infra/variables.tf; everything else mirrors them.

prefix              = "democours"
location            = "francecentral"
resource_group_name = "rg-demo-docker"
admin_username      = "azureuser"

# Required: OpenSSH public key for the administrator account (break-glass only).
admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Optional: repository cloned on the VM.
repo_url = "https://github.com/adam-benyekkou/demo-cours-docker-intro.git"

# Optional, defaults to "demo-cours-docker" (variables.tf). Produces
# <dns_label>.<location>.cloudapp.azure.com and must be unique in the region:
# 3-63 lowercase alphanumeric characters or hyphens. The value below is only an
# example, which is why it differs from the default.
dns_label = "demo-cours-docker-adam"

vm_size            = "Standard_B2s"
data_disk_size_gb  = 32
budget_amount      = 20

# Azure requires at least one contact when the budget is applied.
# budget_contact_emails = ["you@example.com"]
budget_contact_emails = []

tags = {
  project    = "demo-cours-docker-intro"
  managed_by = "terraform"
}
