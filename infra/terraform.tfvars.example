# terraform.tfvars.example — modèle de valeurs à copier en terraform.tfvars.
#
# À copier en terraform.tfvars puis à ajuster : les commentaires signalent les
# valeurs qui diffèrent des défauts d'infra/variables.tf, tout le reste les
# recopie. Terraform ne lit que terraform.tfvars, jamais ce fichier.

prefix              = "democours"
location            = "spaincentral"
resource_group_name = "rg-demo-docker"
admin_username      = "azureuser"

# Obligatoire : clé publique OpenSSH du compte administrateur (secours uniquement).
admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Optionnel, par défaut "demo-cours-docker" (variables.tf). Produit
# <dns_label>.<location>.cloudapp.azure.com et doit être unique dans la région :
# 3-63 caractères alphanumériques minuscules ou tirets. La valeur ci-dessous n'est
# qu'un exemple, c'est pourquoi elle diffère du défaut.
dns_label = "demo-cours-docker-adam"

vm_size            = "Standard_D2s_v4"
data_disk_size_gb  = 32
budget_amount      = 20

# Azure exige au moins un contact quand le budget est appliqué.
# budget_contact_emails = ["you@example.com"]
budget_contact_emails = []

tags = {
  project    = "demo-cours-docker-intro"
  managed_by = "terraform"
}
